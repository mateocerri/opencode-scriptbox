{
  "name": "opencode-scriptbox",
  "version": "0.1.2",
  "description": "Closed-world registry of reusable agent utility scripts for OpenCode: descriptive names plus one-line purpose headers, listed on demand.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateocerri/opencode-scriptbox.git"
  },
  "homepage": "https://www.npmjs.com/package/opencode-scriptbox",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "scripts",
    "registry",
    "agents"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "PROPOSAL.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "2.0.26"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "npx tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  }
}
